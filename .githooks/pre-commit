#!/bin/sh
# Checks what can be checked without Docker. Installed by `pnpm install`
# through the `prepare` script, which points core.hooksPath here.
# Skip with `git commit --no-verify`.
set -e
run() {
  name=$1
  shift
  if ! out=$("$@" 2>&1); then
    printf '%s\n' "$out"
    echo "pre-commit: $name failed"
    exit 1
  fi
  echo "  ok $name"
}
echo "pre-commit:"
run biome pnpm exec biome check
run tsc pnpm exec tsc --noEmit
run vitest pnpm exec vitest run --reporter=dot
run rust pnpm lint:rust
