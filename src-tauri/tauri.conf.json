{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "5db",
  "version": "0.2.0",
  "identifier": "ai.leve.fivedb",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "5db",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0f0d15"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A modern Postgres and Redis client",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQ0E1OTk2MzlCOTlENjgKUldSb25iazVsbG5LWDhZSEZsUktaYTlwdmZURUZQZk1oR3FqMUdzYXB2NUJXZDdXZUlUQmw1RzIK",
      "endpoints": [
        "https://github.com/5ucr4m/5db/releases/latest/download/latest.json"
      ]
    }
  }
}
